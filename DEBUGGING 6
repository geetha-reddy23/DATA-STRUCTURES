#include <stdio.h>

#define MAX 5

int stack[MAX] = {10, 20, 30, 40, 50};
int top = 4;

int pop()
{
    if (top == -1)
    {
        printf("Stack Underflow\n");
        return -1;
    }

    return stack[top--];
}

int main()
{
    int item = pop();

    if (item != -1)
        printf("Popped element: %d", item);

    return 0;
}
