#include <stdio.h>

#define MAX 5

int queue[MAX];
int front = 0, rear = 0;

void enqueue(int x)
{
    if (rear == MAX)
    {
        printf("Queue Overflow\n");
        return;
    }

    queue[rear] = x;
    rear++;

    printf("Value inserted: %d\n", x);
}

int main()
{
    int x;

    printf("Enter the value: ");
    scanf("%d", &x);

    enqueue(x);

    return 0;
}
